#!/usr/bin/env ruby
# PublicWWW from the command line.
#
#   bin/publicwww account
#   bin/publicwww search '"angular.min.js"' [per_page]
#   bin/publicwww export '"angular.min.js"' > sites.txt

require_relative "../lib/publicwww"

cmd, query, per_page = ARGV
unless cmd == "account" || (%w[search export].include?(cmd) && query)
  warn "usage: publicwww account | search QUERY [PER_PAGE] | export QUERY"
  exit 2
end

begin
  pw = PublicWWW::Client.new
  case cmd
  when "account"
    puts JSON.pretty_generate(pw.account)
  when "search"
    page = pw.search(query, per_page: (per_page || 20).to_i)
    puts "#{page['total']} sites match, page #{page['page']} of #{page['total_pages']}" \
         "#{page['truncated'] ? ' (cut short by the plan)' : ''}"
    page["results"].each { |r| puts [r["rank"], r["domain"], r["url"]].join("\t") }
  when "export"
    meta = pw.each_result(query) { |r| puts r["url"] }
    warn "note: the plan returned #{meta['returned']} of #{meta['total']}" if meta && meta["truncated"]
  end
rescue PublicWWW::Error => e
  warn e.message
  exit 1
end
